# soc_axi_lite_arb: safety by induction (prove), bounded completion time in a fair
# environment (live), and reachability of the interesting states (cover).
[tasks]
prove
live
cover

[options]
prove: aigsmt z3
live: aigsmt z3
prove: mode prove
live: mode prove
cover: mode cover
cover: depth 24

[engines]
prove: abc pdr
live: abc pdr
cover: smtbmc z3

[script]
live: read -define LIVE
read -formal soc_axi_lite_arb.v
read -formal arb_formal.sv
prep -top arb_formal

[files]
../../hdl/soc_axi_lite_arb.v
arb_formal.sv
